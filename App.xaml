<Application x:Class="ProxySandboxMvp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#080B14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#101629" />
        <SolidColorBrush x:Key="InkBrush" Color="#D9F9FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7C8CA8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00F0FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#28345F" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2A6D8A" />
            <Setter Property="Background" Value="#151D39" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1020" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1020" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0B1020" />
            <Setter Property="Foreground" Value="#D9F9FF" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#00F0FF" />
                    <Setter Property="Foreground" Value="#080B14" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D2B59" />
                    <Setter Property="Foreground" Value="#00F0FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0F1221" />
            <Setter Property="Foreground" Value="#D9F9FF" />
            <Setter Property="BorderBrush" Value="#28345F" />
            <Setter Property="RowBackground" Value="#101629" />
            <Setter Property="AlternatingRowBackground" Value="#141B32" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#202A4A" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#182247" />
            <Setter Property="Foreground" Value="#00F0FF" />
            <Setter Property="BorderBrush" Value="#28345F" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Application.Resources>
</Application>
